#!/bin/sh
# shellcheck source=/dev/null

G350_INITIALISE_RUMBLE_GPIO() {
	[ "$(cat /opt/muos/device/config/board/name 2>/dev/null)" = rk-g350-v ] || return 0

	G350_RUMBLE_GPIO=/sys/class/gpio/gpio15
	[ -d "$G350_RUMBLE_GPIO" ] || printf '%s' 15 >/sys/class/gpio/export 2>/dev/null || return 1

	G350_GPIO_ATTEMPT=0
	while [ ! -d "$G350_RUMBLE_GPIO" ] && [ "$G350_GPIO_ATTEMPT" -lt 20 ]; do
		G350_GPIO_ATTEMPT=$((G350_GPIO_ATTEMPT + 1))
		sleep 0.05
	done
	[ -d "$G350_RUMBLE_GPIO" ] || return 1

	# The "low" changes the direction and output value
	printf "%s" low >"$G350_RUMBLE_GPIO/direction"
}

G350_INITIALISE_RUMBLE_GPIO

. /opt/muos/script/var/func.sh

if ! /opt/muos/script/system/rootfs.sh restore; then
	LOG_WARN "$0" 0 "BOOTING" "Unable to restore one or more common rootfs configurations"
fi

INIT_DIR="/opt/muos/script/init"

RUN_ASYNC_START() {
	RUN_INIT_RECORDED start "$INIT_DIR/async/S06mount.sh"
	RUN_INIT_DIR_BOUNDED start "$INIT_DIR/async" forward "S06mount.sh $MUOS_INIT_DEFERRED"
}

case "${1:-start}" in
	start | "")
		LED_QUIET
		BOOT_GUARD_ARM

		timeout 10 "$MUOS_VAR_BIN" build ||
			LOG_WARN "$0" 0 "BOOTING" "Config cache build failed or timed out, continuing without it"

		FBCON_DISABLE
		(RUN_ASYNC_START) >/dev/null 2>&1 &

		BOOT_PROGRESS_START
		RUN_INIT_DIR start "$INIT_DIR" forward
		;;
esac

exit 0
