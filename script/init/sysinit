#!/bin/sh
# shellcheck source=/dev/null

. /opt/muos/script/var/func.sh

INIT_DIR="/opt/muos/script/init"

RUN_ASYNC_START() {
	RUN_INIT_RECORDED start "$INIT_DIR/async/S06mount.sh"
	RUN_INIT_DIR_BOUNDED start "$INIT_DIR/async" forward "S06mount.sh"
}

case "${1:-start}" in
	start | "")
		FBCON_DISABLE
		(RUN_ASYNC_START) >/dev/null 2>&1 &
		RUN_INIT_DIR start "$INIT_DIR" forward
		;;
esac

exit 0
