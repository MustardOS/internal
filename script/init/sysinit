#!/bin/sh
# shellcheck source=/dev/null

G350_INITIALISE_RUMBLE_GPIO() {
	[ "$(cat /opt/muos/device/config/board/name 2>/dev/null)" = rk-g350-v ] || return 0

	G350_RUMBLE_GPIO=/sys/class/gpio/gpio15
	[ -d "$G350_RUMBLE_GPIO" ] || printf '%s' 15 >/sys/class/gpio/export 2>/dev/null || return 1

	G350_GPIO_ATTEMPT=0
	while [ ! -d "$G350_RUMBLE_GPIO" ] && [ "$G350_GPIO_ATTEMPT" -lt 20 ]; do
		G350_GPIO_ATTEMPT=$((G350_GPIO_ATTEMPT + 1))
		sleep 0.05
	done
	[ -d "$G350_RUMBLE_GPIO" ] || return 1

	# The "low" changes the direction and output value
	printf "%s" low >"$G350_RUMBLE_GPIO/direction"
}

G350_INITIALISE_RUMBLE_GPIO

. /opt/muos/script/var/boot.sh
. /opt/muos/script/var/display.sh
. /opt/muos/script/var/runtime.sh

if ! /opt/muos/script/system/rootfs.sh restore; then
	LOG_WARN "$0" 0 "BOOTING" "Unable to restore one or more common rootfs configurations"
fi

INIT_DIR="/opt/muos/script/init"

RUN_ASYNC_START() {
	RUN_INIT_RECORDED start "$INIT_DIR/async/S06mount.sh"
	RUN_INIT_DIR_BOUNDED start "$INIT_DIR/async" forward "S06mount.sh $MUOS_INIT_DEFERRED"
}

RUN_BOOT_SERVICE() {
	SERVICE_SCRIPT=$1
	SERVICE_NAME=$2
	RUN_INIT_RECORDED start "$INIT_DIR/$SERVICE_SCRIPT" ||
		LOG_WARN "$0" 0 "BOOTING" "$SERVICE_NAME initialisation reported an error"
}

RUN_BOOT_SERVICE_AFTER_PAINT() {
	WAIT_FOR_FIRST_PAINT 200
	RUN_BOOT_SERVICE "$1" "$2"
}

RUN_CRITICAL_START() {
	RUN_INIT_RECORDED start "$INIT_DIR/S10udev.sh" &
	UDEV_PID=$!
	RUN_INIT_RECORDED start "$INIT_DIR/S30dbus.sh" &
	DBUS_PID=$!

	if ! wait "$UDEV_PID"; then
		LOG_WARN "$0" 0 "BOOTING" "udev initialisation reported an error"
	fi

	if ! wait "$DBUS_PID"; then
		LOG_WARN "$0" 0 "BOOTING" "D-Bus initialisation reported an error"
	fi

	AUDIO_WAIT=$(GET_VAR "config" "settings/advanced/audio_ready")
	if IS_ONE "$AUDIO_WAIT"; then
		RUN_BOOT_SERVICE S75bluetooth.sh Bluetooth &
	else
		RUN_BOOT_SERVICE_AFTER_PAINT S75bluetooth.sh Bluetooth &
	fi
	BLUETOOTH_PID=$!
	RUN_BOOT_SERVICE S80pipewire.sh PipeWire &
	PIPEWIRE_PID=$!
	RUN_BOOT_SERVICE S81mode.sh "Device mode" &
	MODE_PID=$!

	wait "$MODE_PID"

	if IS_ONE "$AUDIO_WAIT"; then
		wait "$PIPEWIRE_PID"
		wait "$BLUETOOTH_PID"
	fi

	RUN_INIT_RECORDED start "$INIT_DIR/S99muos.sh"
}

case "${1:-start}" in
	start | "")
		LED_QUIET
		RUN_DEVICE_SCRIPT led.sh boot &
		BOOT_GUARD_ARM

		timeout 10 "$MUOS_VAR_BIN" build ||
			LOG_WARN "$0" 0 "BOOTING" "Config cache build failed or timed out, continuing without it"

		EARLY_GOVERNOR=$(GET_VAR "device" "cpu/governor")
		[ -w "$EARLY_GOVERNOR" ] && printf '%s' performance >"$EARLY_GOVERNOR"

		FBCON_DISABLE
		RUN_DEVICE_SCRIPT display.sh recover ||
			LOG_WARN "$0" 0 "BOOTING" "Device display handover recovery reported an error"
		(RUN_ASYNC_START) >/dev/null 2>&1 &

		RUN_CRITICAL_START
		;;
esac

exit 0
